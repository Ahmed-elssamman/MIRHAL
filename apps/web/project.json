{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "prefix": "lq",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/web"],
      "options": {
        "outputPath": "dist/web",
        "index": "apps/web/src/index.html",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          },
          {
            "glob": "*.svg",
            "input": "libs/ui/assets/avatars",
            "output": "avatars"
          }
        ],
        "styles": ["libs/ui/src/styles.css"],
        "server": "apps/web/src/main.server.ts",
        "ssr": {
          "entry": "apps/web/src/server.ts"
        },
        "outputMode": "server"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "560kB",
              "maximumError": "800kB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/web/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4200,
        "host": "0.0.0.0",
        "allowedHosts": ["192.168.1.112"],
        "proxyConfig": "apps/web/proxy.conf.mjs"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/web/tsconfig.spec.json",
        "buildTarget": "web:build:development",
        "runner": "vitest",
        "watch": false
      }
    }
  }
}
