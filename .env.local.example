# ==============================================================================
# MIRHAL Platform — Local Development Quickstart (.env.local)
# ==============================================================================
# Copy this file to `.env.local` to start working locally immediately.
# ==============================================================================

# ==============================================================================
# OPTION A: Full Local Stack (Web on 4200, Admin on 4201, API on 3333, DB on 55432)
# ==============================================================================
# 1. Start local PostgreSQL: npm run db:local
# 2. Start full dev stack:   npm run dev
# ==============================================================================

NODE_ENV=development
PORT=3333

# Local PostgreSQL Provisioned by `npm run db:local`
DATABASE_URL=postgresql://lifequest:local-only@127.0.0.1:55432/lifequest
DIRECT_URL=postgresql://lifequest:local-only@127.0.0.1:55432/lifequest
TEST_DATABASE_URL=postgresql://lifequest:local-only@127.0.0.1:55432/lifequest_test

# Local Origins
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4201
APP_URL=http://localhost:4200
API_ORIGIN=http://localhost:3333

# Email Service: File-based local inbox (emails written to .local/mail/)
MAIL_MODE=development
EMAIL_PROVIDER=file
SMTP_FROM="مِرحال MIRHAL" <noreply@mirhal.app>
SUPPORT_EMAIL=support@mirhal.app

# Local Rate Limiting
RATE_LIMIT_MODE=memory

# ==============================================================================
# OPTION B: Hybrid Development (Local Web + Remote Render Production API)
# ==============================================================================
# Change API_ORIGIN above to https://mirhal.onrender.com, then run:
# npm run dev:hybrid
# Hybrid mode starts Web and Admin without local PostgreSQL.
# ==============================================================================

