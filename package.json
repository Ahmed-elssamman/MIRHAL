{
  "name": "mirhal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p web admin api --parallel=3",
    "dev:web": "nx serve web",
    "dev:admin": "nx serve admin",
    "dev:api": "nx serve api",
    "start:prod": "node dist/api/apps/api/src/main.js",
    "worker": "node dist/api/apps/api/src/worker.js",
    "worker:dev": "tsx --tsconfig apps/api/tsconfig.app.json apps/api/src/worker.ts",
    "build:api": "nx build api",
    "build": "nx run-many -t build -p web admin api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit && ngc -p apps/web/tsconfig.app.json --noEmit && ngc -p apps/admin/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:ssr": "node tools/verify-ssr.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local": "node tools/local-db.mjs",
    "db:validate": "prisma validate",
    "test:frontend": "nx test web",
    "db:check-migrations": "node tools/validate-migrations.mjs",
    "security:check": "node tools/verify-source-safety.mjs",
    "vercel:package": "npm run build && node tools/vercel/package.mjs",
    "vercel:package:render": "npm run build && node tools/vercel/package.mjs --render",
    "vercel:configure": "node tools/vercel/configure-env.mjs",
    "vercel:verify": "node tools/vercel/verify.mjs",
    "test:performance": "node tools/audit-performance.mjs"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/platform-server": "21.2.24",
    "@angular/router": "21.2.24",
    "@angular/service-worker": "21.2.24",
    "@angular/ssr": "21.2.24",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@primeuix/themes": "2.0.3",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "lucide-angular": "1.0.0",
    "nodemailer": "^10.0.10",
    "primeng": "21.1.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@nx/angular": "^22.7.12",
    "@nx/js": "^22.7.12",
    "@nx/workspace": "^22.7.12",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "@vercel/nft": "^1.11.0",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "jsdom": "^27.2.0",
    "magicast": "0.3.5",
    "nx": "^22.7.12",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8",
    "yaml": "2.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@module-federation/dts-plugin": {
      "undici": "7.29.1"
    },
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "piscina": "5.3.2",
    "smol-toml": "1.7.1",
    "nx": {
      "brace-expansion": "5.0.12"
    },
    "uuid@<11.1.1": "11.1.1"
  }
}
