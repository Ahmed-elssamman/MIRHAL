# ==============================================================================
# MIRHAL Platform — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` for local development.
# 2. Never commit `.env` or expose production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Set to 'production' in live environments to enforce HTTPS-only cookies.
# Set to 'development' for local work, or 'test' during test execution.
NODE_ENV=development
PORT=3333

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database
# ------------------------------------------------------------------------------
# Primary database connection string (connection-pooled in production, e.g. Neon/Supabase/Render).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/lifequest

# Direct database connection string (required for migrations; unpooled).
DIRECT_URL=postgresql://postgres:postgres@localhost:55432/lifequest

# Dedicated database for running vitest integration and migration tests.
# Provisioned automatically by `npm run db:local`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/lifequest_test

# ------------------------------------------------------------------------------
# 3. Application Origins & URLs
# ------------------------------------------------------------------------------
# Web application origin (where users access the main app).
WEB_ORIGIN=http://localhost:4200

# Admin application origin (where admins access the control panel).
ADMIN_ORIGIN=http://localhost:4201

# Canonical public application URL for links generated in transactional emails.
APP_URL=http://localhost:4200

# ------------------------------------------------------------------------------
# 4. Email Service Configuration
# ------------------------------------------------------------------------------
# MAIL_MODE options:
#   - 'development': Sends through the configured real provider.
#   - 'production': Sends through the configured real provider.
#   - 'disabled': Test environments only.
MAIL_MODE=development

# EMAIL_PROVIDER options:
#   - 'file': Automated tests only; never use for local development or production.
#   - 'smtp': Delivers via SMTP (e.g., Google Workspace, Gmail App Password, AWS SES).
#   - 'resend': Delivers via the Resend API (requires RESEND_API_KEY).
EMAIL_PROVIDER=smtp

# --- SMTP Provider Settings (when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="مِرحال MIRHAL" <noreply@mirhal.app>
SUPPORT_EMAIL=support@mirhal.app

# --- Resend Provider Settings (when EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 6. Dev Proxy & Hybrid Development (Local Web -> Remote API)
# ------------------------------------------------------------------------------
# By default, Angular dev server proxies `/api` calls to `http://localhost:3333`.
# To test your local web client against the deployed Render API:
#   API_ORIGIN=https://mirhal.onrender.com
#   VERCEL_WEB_ORIGIN=https://mirhal-web.vercel.app
API_ORIGIN=http://localhost:3333
VERCEL_WEB_ORIGIN=https://mirhal-web.vercel.app
VERCEL_ADMIN_ORIGIN=https://mirhal-admin.vercel.app

# ------------------------------------------------------------------------------
# 7. Security & Maintenance
# ------------------------------------------------------------------------------
# Bearer token for triggering scheduled maintenance and attachment cleanup via HTTP.
CRON_SECRET=
