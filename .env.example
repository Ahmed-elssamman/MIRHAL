# Copy to .env. Keep actual credentials exclusively in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/lifequest?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/lifequest?sslmode=require
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/lifequest_test
NODE_ENV=development
# Production must use NODE_ENV=production for Secure session cookies.
# Authentication uses random opaque sessions; a JWT secret is not used.
PORT=3333
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4201
APP_URL=http://localhost:4200
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
MAIL_MODE=development
# Local: file (default) or smtp. Production: resend. MAIL_MODE=disabled disables auth email.
EMAIL_PROVIDER=file

# Local Gmail SMTP: use a Google App Password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional customer support contact shown in transactional email footers.
SUPPORT_EMAIL=
# Production API email, required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
VERCEL_API_ORIGIN=
SSR_ALLOWED_HOSTS=localhost,127.0.0.1

# Feedback screenshots are stored in the configured PostgreSQL database.
# Optional Vercel packaging
VERCEL_WEB_ORIGIN=
VERCEL_ADMIN_ORIGIN=
CRON_SECRET=
# Set MAIL_MODE=disabled to run without verification/recovery email delivery.

# Redis Rate Limiting
# Production requires REDIS_URL or Upstash-compatible Redis.
# Development and tests can use RATE_LIMIT_MODE=memory.
RATE_LIMIT_MODE=memory
REDIS_URL=redis://127.0.0.1:6379
